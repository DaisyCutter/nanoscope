# Copy to .env in the repository root and fill in your local values.
# Keep secrets out of VITE_* variables: those are exposed to the browser.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_API_PORT=8081
MQTT_API_USER=
MQTT_API_PASS=
NANOSCOPE_SERVER=http://127.0.0.1:8090
NANOSCOPE_MODE=server
# Optional backend configuration:
# LISTEN=127.0.0.1:8090
# DB_PATH=nanoscope.db
# MAX_PAYLOAD=65536
# STATIC_DIR=../app/dist
